{
  "name": "stilltime",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @starter/web build && PUBLIC_API_URL=http://localhost:8787 pnpm --parallel --filter @starter/api --filter @starter/web dev",
    "dev:api": "pnpm --filter @starter/api dev",
    "dev:web": "pnpm --filter @starter/web dev",
    "build": "PUBLIC_API_URL='' pnpm --filter @starter/web build && pnpm --filter @starter/api build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "db:migrate": "pnpm --filter @starter/api exec wrangler d1 migrations apply stilltime-db --local --config ../../wrangler.jsonc",
    "deploy": "pnpm run build && pnpm --filter @starter/api run deploy"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "typescript": "~5.9.3"
  }
}
